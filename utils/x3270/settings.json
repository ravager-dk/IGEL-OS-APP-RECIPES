[
  {
    "key": "mode",
    "group": "connection",
    "type": "string",
    "default": "local",
    "label": "Configuration source",
    "tooltip": "Local preserves normal x3270 startup and its saved settings. UMS uses the fields below at each launch; changes do not interrupt an existing connection.",
    "choices": [
      [
        "local",
        "Local / application defaults"
      ],
      [
        "profile",
        "UMS profile"
      ]
    ]
  },
  {
    "key": "host",
    "group": "connection",
    "type": "string",
    "default": "",
    "label": "Server hostname or IP address",
    "tooltip": "Host only; do not include a port, LU name, TLS prefix or URL. Bare or bracketed IPv6 is accepted. Empty opens the GUI without connecting."
  },
  {
    "key": "port",
    "group": "connection",
    "type": "integer",
    "default": "23",
    "label": "Server port",
    "tooltip": "TCP port, 1 through 65535. Set 992 or your site-specific port for direct TLS; changing connection mode does not change this value."
  },
  {
    "key": "transport",
    "group": "connection",
    "type": "string",
    "default": "auto",
    "label": "Connection mode",
    "tooltip": "Automatic allows TELNET STARTTLS negotiation but does not require encryption. Direct TLS encrypts from connection start. Plain disables STARTTLS.",
    "choices": [
      [
        "auto",
        "Automatic (STARTTLS if offered)"
      ],
      [
        "tls",
        "Direct TLS"
      ],
      [
        "plain",
        "Plain TN3270 (no STARTTLS)"
      ]
    ]
  },
  {
    "key": "lu",
    "group": "connection",
    "type": "string",
    "default": "",
    "label": "LU name",
    "tooltip": "Optional single LU / terminal identifier. Leave empty for host allocation. This is not a username."
  },
  {
    "key": "tn3270e",
    "group": "connection",
    "type": "bool",
    "default": "true",
    "label": "Enable TN3270E",
    "tooltip": "Unchecked adds the N: host prefix. Applies when a server is configured."
  },
  {
    "key": "disconnect",
    "group": "connection",
    "type": "string",
    "default": "stay",
    "label": "On disconnect",
    "tooltip": "Reconnect and exit require a configured server.",
    "choices": [
      [
        "stay",
        "Keep window open"
      ],
      [
        "reconnect",
        "Reconnect automatically"
      ],
      [
        "exit",
        "Close application"
      ]
    ]
  },
  {
    "key": "verify_certificate",
    "group": "security",
    "type": "bool",
    "default": "true",
    "label": "Verify server certificate",
    "tooltip": "Verify TLS trust and hostname. Uncheck only if you deliberately want unverified TLS."
  },
  {
    "key": "ca_file",
    "group": "security",
    "type": "string",
    "default": "",
    "label": "CA certificate file (PEM)",
    "tooltip": "Optional absolute endpoint path to a PEM CA bundle deployed using UMS Files. Empty uses the platform trust defaults."
  },
